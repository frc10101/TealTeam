# The standard FRC event profile: a 3v3 match, six robots, the FIRST Events
# API and The Blue Alliance as the source of the schedule.
#
# Plain KEY=VALUE, read (never sourced) by deploy/pi/bootstrap.sh and
# deploy/event/prep-event.sh. Copy it to make a profile for one event; keep the
# copy out of git if it holds anything private.
#
# Keys that do NOT start with PREP_ go into the Pi's env file
# (/opt/tealteam/.env). An EMPTY value means "ask": bootstrap.sh prompts for
# it. Names containing KEY, USERNAME or AUTH are secrets: typed with no echo,
# never written anywhere but that file (mode 600). Keys are never committed.
# Not listed, so not asked: FIRST_COUNTRY (only used when no event code and no
# team number are set) and the optional TETHER_INTERFACES, BACKUP_COPY_TO.

# ── The Pi's env file ───────────────────────────────────────────────────────
# Production. Anything else lets a missing variable drop the schema (spec 12.10).
TEALTEAM_ENV=prod
PORT=8080
DATABASE_URL=sqlite:///srv/tealteam/data/tealteam.db
BACKUP_DIR=/srv/tealteam/backups

# Upstream data. The Pi has no internet at the event: load the event at the
# shop first (tt-web bulk-load), then these keys only matter for the shop.
FIRST_SEASON=2026
FIRST_SYNC_ON_BOOT=true
FIRST_API_USERNAME=
FIRST_API_KEY=
TBA_AUTH_KEY=
# The FIRST event code, e.g. TXHOU. Asked for.
FIRST_EVENT_CODE=
FIRST_TEAM_NUMBER=10101

# ── Event prep (deploy/event/prep-event.sh); read from a laptop ─────────────
# A match has 6 robots (3v3), so 6 scouts cover every robot. How many scouts the
# auto-assign hands robots to (the first this many scouts
# in the roster). Fewer in the roster: it uses them all and says so.
PREP_SCOUTS=6
# sync: ask the server to pull the schedule from FIRST and TBA (the lead scout
# page's Sync now), then wait for matches; with no internet that fails and the
# bulk-loaded schedule already in the database is used. existing: just
# confirm the matches are there.
PREP_SCHEDULE=sync
# The event code the server stores the event under is the season and the code
# in lower case (2026txhou). Empty: made from FIRST_EVENT_CODE, or asked for.
# Set PREP_EVENT_KEY only when TBA's key for the event differs.
PREP_EVENT_CODE=
PREP_EVENT_KEY=
PREP_TEAM_NUMBER=10101
# Relative paths are from where prep-event.sh is run. Use a copy of
# deploy/event/roster.example.csv.
PREP_ROSTER=deploy/event/roster.example.csv
# Where the sign-in sheet (names and temporary passwords) goes. Empty:
# signin-sheet-<event>.txt here, which .gitignore keeps out of git.
PREP_SIGNIN_SHEET=
