# Event profile: an FTC qualifier, 4 robots a match (2 red + 2 blue), one Pi,
# four scout laptops, one lead laptop, phones for viewing (F12).
#
# Plain KEY=VALUE, one per line, no quotes or `export`. Read (not sourced) by
# deploy/pi/bootstrap.sh and deploy/event/prep-event.sh. Nothing secret lives
# here: a secret listed with an empty value is asked for when it is needed,
# and never written back to this file or to git.

# ── The Pi's env file (/opt/tealteam/.env) ──────────────────────────────────
# Production. The default "test"-style reset of the database is refused.
TEALTEAM_ENV=prod
PORT=8080
DATABASE_URL=sqlite:///srv/tealteam/data/tealteam.db
BACKUP_DIR=/srv/tealteam/backups

# Upstream FIRST / TBA is off on this build, and the Pi has no internet at
# the venue. Those keys are left out of the file on purpose.

# Optional FTC Events pull (docs/FTC_BETA_API.md). Both empty = skip: no
# button, no request. Both set = the lead's schedule page can pull USALATQ.
FTC_EVENT_CODE=USALATQ
FTC_API_USERNAME=
FTC_API_KEY=

# The scouting assistant (/ask) is off unless this is set to "local" with
# ASK_URL (docs/SCOUTING_ASSISTANT.md). Leave empty: at the venue only a
# model on the LAN works, and the page then says it is not set up.
ASK_BACKEND=

# Secrets above: asked for by bootstrap.sh, kept out of this file, and
# skipped with --non-interactive.
SECRET_KEYS=FTC_API_USERNAME,FTC_API_KEY

# ── Event prep (deploy/event/prep-event.sh) ─────────────────────────────────
# Alliance size 2 is built into this build; a match has 4 robots.
PREP_ROBOTS_PER_MATCH=4
# One laptop per robot. Auto-assign copes with 2 to 4 (F1b leaves the
# open robots to the least-seen teams); fewer than 4 leaves some uncovered.
PREP_SCOUTS=4
PREP_SCOUTS_MIN=2
PREP_SCOUTS_MAX=4
PREP_EVENT_CODE=USALATQ
PREP_EVENT_NAME=Athens Qualifier
PREP_TIMEZONE=America/Chicago
PREP_EVENT_DATE=2026-10-24
# Our own team number: the lead's, so auto-assign scouts our robot last.
PREP_TEAM_NUMBER=
# Who signs in as the admin on the lead laptop (first account on a new
# database is the admin). Empty = the first admin row in the roster.
PREP_ADMIN_EMAIL=
# name,email-or-username,role,team  (role: scout|lead|coach|admin)
PREP_ROSTER=deploy/event/roster.example.csv
# Where the schedule comes from: csv, ftc, or auto (the FTC pull when the
# server offers it, i.e. both keys are set on the Pi, else the CSV).
PREP_SCHEDULE_SOURCE=auto
# match,red1,red2,blue1,blue2 (a * after a team marks a surrogate). Paths are
# from the repo root. This is the 12-team rehearsal schedule: prep-event.sh
# refuses it unless run with --rehearsal, which files it under the event code
# below instead of the real one. Pass the real schedule with --csv on the day.
PREP_SCHEDULE_CSV=docs/FTC_BETA_REHEARSAL_SCHEDULE.csv
PREP_REHEARSAL_CODE=REHEARSAL
PREP_SEASON=2026
