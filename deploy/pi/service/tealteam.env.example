# The server's settings on the Pi (P10). install.sh copies this to
# /opt/tealteam/.env once, if there is none, and never overwrites it after.
# Readable by the tealteam user only: it holds API keys.
DATABASE_URL=sqlite:///srv/tealteam/data/tealteam.db
BACKUP_DIR=/srv/tealteam/backups
PORT=8080

# HTTPS (H1; docs/event/HTTPS_SETUP.md), beside plain HTTP on PORT. The Pi
# forwards 443 here. On first start the server makes its own certificate
# authority in TLS_DIR (default: a tls folder beside the database); every
# device trusts it once, from http://tealteam.local/ca.crt. TLS_PORT=off
# turns HTTPS off; TLS_CERT and TLS_KEY use a certificate made elsewhere.
TLS_PORT=8443
#TLS_DIR=/srv/tealteam/data/tls
#TLS_NAMES=
#TLS_CERT=
#TLS_KEY=

# Upstream data. Leave blank to run without it.
FIRST_API_USERNAME=
FIRST_API_KEY=
FIRST_SEASON=2026
TBA_AUTH_KEY=

# A USB-tethered phone syncs the moment it is plugged in (S6). Unset watches
# usb0 and eth1, as tealteam-uplink.nmconnection does; off stops it.
#TETHER_INTERFACES=usb0,eth1
