<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- The web app, advertised over mDNS (P4). The host name itself,
     tealteam.local, comes from the Pi's hostname; this adds a browsable
     service entry. Installed to /etc/avahi/services/tealteam.service. -->
<service-group>
  <name>TealTeam scouting</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
