#!/usr/sbin/nft -f
# http://tealteam.local and https://tealteam.local, with no port: redirect 80
# and 443 to the app's own ports (8080, and 8443 for HTTPS, H1), so the server
# needs no privilege to bind (P4). Loaded by tealteam-port80.service.
# The add-then-delete pair makes reloading it replace, not duplicate.
table ip tealteam_port80
delete table ip tealteam_port80

table ip tealteam_port80 {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "eth0" tcp dport 80 redirect to :8080
        iifname "eth0" tcp dport 443 redirect to :8443
    }
    # So `curl http://localhost` and `https://localhost` on the Pi reach it too.
    chain output {
        type nat hook output priority -100; policy accept;
        oifname "lo" tcp dport 80 redirect to :8080
        oifname "lo" tcp dport 443 redirect to :8443
    }
}
