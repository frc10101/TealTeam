{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./web/static/js",
    "rootDir": "./web/static/js",
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["web/static/js/**/*.ts"],
  "exclude": ["node_modules"]
}
