{
  "name": "your-app",
  "version": "1.0.0",
  "description": "Go + HTMX + Tailwind CSS web application template",
  "private": true,
  "scripts": {
    "css:build": "npx tailwindcss -i ./web/tailwind/input.css -o ./web/static/css/site.css --minify",
    "css:watch": "npx tailwindcss -i ./web/tailwind/input.css -o ./web/static/css/site.css --watch",
    "ts:build": "tsc",
    "ts:watch": "tsc --watch",
    "build": "npm run css:build && npm run ts:build",
    "dev": "concurrently \"npm run css:watch\" \"npm run ts:watch\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
