# Copy to .env and fill in. Existing environment variables always win over .env.
# Full descriptions: docs/REBUILD_SPEC.md §8

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
# The rebuild targets SQLite (see REBUILD_SPEC.md §10). Path to the DB file.
DATABASE_URL=sqlite://./tealteam.db

# Guard for destructive migration resets. Default to the SAFE value.
# The retired implementation defaulted this to "test", which dropped the
# migration history on boot — see REBUILD_SPEC.md §12.10.
TEALTEAM_ENV=prod

# ── FIRST Events API (HTTP basic auth) ──────────────────────────────────────
# Register at https://frc-events.firstinspires.org/services/API
FIRST_API_USERNAME=
FIRST_API_KEY=
FIRST_SEASON=2026
FIRST_SYNC_ON_BOOT=true

# Optional filters to keep the sync small. If neither EVENT_CODE nor
# TEAM_NUMBER is set, results are filtered by COUNTRY (default "USA").
FIRST_EVENT_CODE=
FIRST_TEAM_NUMBER=10101
FIRST_COUNTRY=

# ── The Blue Alliance ───────────────────────────────────────────────────────
# Get a key at https://www.thebluealliance.com/account
# Leave empty to disable the background team-stats sync loop entirely.
TBA_AUTH_KEY=
