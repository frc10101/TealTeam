# Server Configuration
PORT=8080

# Database Configuration (Optional)
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/yourdb?sslmode=disable

# Local Docker Postgres data directory (host path).
# Used by docker-compose to persist DB state across reboots/power cycles.
DB_DATA_PATH=./.data/postgres

# FIRST Events API (Basic auth)
FIRST_API_USERNAME="NotMaxwell"
FIRST_API_KEY="6264f126-16be-4f85-abfb-8924ffbcc5d3"
FIRST_SEASON="2026"
FIRST_SYNC_ON_BOOT="true"

# Optional filters to keep the sync small
FIRST_EVENT_CODE=
FIRST_TEAM_NUMBER="10101"
FIRST_COUNTRY=
