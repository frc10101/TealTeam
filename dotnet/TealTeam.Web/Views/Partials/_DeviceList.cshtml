@using TealTeam.Web.Controllers
@{
    var deviceOptions = ViewData["DeviceOptions"] as List<AssignmentsController.DeviceOption> ?? new();
}
<div id="device-list" class="space-y-3 fade-swap">
    <p class="text-sm text-gray-400">
        Every browser that opens this site registers itself automatically and keeps a permanent ID on that
        device. Give devices friendly names (e.g. "Stands Tablet 1") so you can assign robots to the device
        no matter who is signed in on it.
    </p>
    @if (deviceOptions.Count == 0)
    {
        <div class="text-sm text-gray-500">No devices registered yet. Open this site on a scouting tablet and it will appear here.</div>
    }
    else
    {
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var device in deviceOptions)
            {
                <form action="/hx/devices/@device.Id/rename" method="post" up-submit up-target="#device-list"
                      class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 flex items-center gap-2">
                    <span class="@(device.Online ? "text-teal-300" : "text-gray-600")" title="@(device.Online ? "Connected" : "Offline")">●</span>
                    <input name="name" value="@device.Name"
                           class="flex-1 min-w-0 rounded border border-gray-700 bg-gray-800 px-2 py-1.5 text-sm text-gray-200" />
                    <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                </form>
            }
        </div>
    }
</div>
