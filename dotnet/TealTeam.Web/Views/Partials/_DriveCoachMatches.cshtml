@{
    var matches = ViewData["DriveCoachMatches"] as List<DriveCoachMatch>;
}
<div id="drive-coach-matches-content">
    @if (ViewData["DriveCoachUpdatedAt"] is string updatedAt && updatedAt != "")
    {
        <div class="mb-3 text-xs text-gray-500">Last updated: @updatedAt</div>
    }
    @if (ViewData["DriveCoachError"] is string coachError && coachError != "")
    {
        <div class="rounded-lg border border-red-600 bg-red-900/30 px-4 py-3 text-sm text-red-200">
            <div class="font-semibold">Unable to load team schedule</div>
            <div class="mt-1">@coachError</div>
            <div class="mt-2 text-xs text-red-300/90">Try these checks: confirm event is selected, verify internet connectivity, and ensure FIRST API credentials are configured on the server.</div>
        </div>
    }
    else if (matches is { Count: > 0 })
    {
        <div class="space-y-4">
            @foreach (var match in matches)
            {
                var badgeClass = match.Status switch
                {
                    "current" => "bg-yellow-600 text-white",
                    "completed" => "bg-gray-700 text-gray-200",
                    _ => "bg-teal-700 text-white",
                };
                <div class="rounded-lg border p-4 @match.StatusClass transition-colors">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg font-semibold text-gray-100">@match.Description</h2>
                                <span class="rounded-full px-2 py-0.5 text-xs font-semibold @badgeClass">@match.StatusLabel</span>
                            </div>
                            <div class="mt-1 text-sm text-gray-400">
                                Match @match.MatchNumber
                                @if (match.TimeDisplay != "")
                                {
                                    @:• @match.TimeDisplay
                                }
                                @if (match.OurAlliance == "Red")
                                {
                                    @:• You are Red
                                }
                                else if (match.OurAlliance == "Blue")
                                {
                                    @:• You are Blue
                                }
                            </div>
                            @if (match.OurPartners.Count > 0)
                            {
                                <div class="mt-2 text-sm text-gray-300">
                                    Partners:
                                    @foreach (var partner in match.OurPartners)
                                    {
                                        <a href="/teams?team=@partner" class="ml-1 text-teal-300 hover:text-teal-200">@partner</a>
                                    }
                                </div>
                            }
                        </div>

                    </div>

                    <div class="mt-4 grid gap-3 md:grid-cols-2">
                        <div class="rounded-lg border border-red-700 bg-red-900/20 p-3">
                            <div class="text-xs font-semibold uppercase tracking-wide text-red-300">Red Alliance</div>
                            <ul class="mt-2 space-y-1">
                                @foreach (var team in match.RedTeams)
                                {
                                    <li class="flex items-center justify-between text-sm">
                                        <a href="/teams?team=@team.TeamNumber" class="font-mono text-gray-100 hover:text-teal-200">Team @team.TeamNumber</a>
                                        <span class="text-xs text-gray-400">OPR @ViewHelpers.Float1(team.Opr) • DPR @ViewHelpers.Float1(team.Dpr)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="rounded-lg border border-blue-700 bg-blue-900/20 p-3">
                            <div class="text-xs font-semibold uppercase tracking-wide text-blue-300">Blue Alliance</div>
                            <ul class="mt-2 space-y-1">
                                @foreach (var team in match.BlueTeams)
                                {
                                    <li class="flex items-center justify-between text-sm">
                                        <a href="/teams?team=@team.TeamNumber" class="font-mono text-gray-100 hover:text-teal-200">Team @team.TeamNumber</a>
                                        <span class="text-xs text-gray-400">OPR @ViewHelpers.Float1(team.Opr) • DPR @ViewHelpers.Float1(team.Dpr)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (ViewData["DriveCoachInfo"] is string coachInfo && coachInfo != "")
    {
        <div class="rounded-lg border border-amber-600 bg-amber-900/20 px-4 py-6 text-center text-sm text-amber-200">
            <div class="font-semibold">Schedule not ready yet</div>
            <div class="mt-1">@coachInfo</div>
        </div>
    }
    else
    {
        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-6 text-center text-sm text-gray-400">
            <div class="font-semibold text-gray-300">Select an event to load your team schedule.</div>
            <div class="mt-1 text-xs">If you already selected one, refresh the page and try again.</div>
        </div>
    }
</div>
