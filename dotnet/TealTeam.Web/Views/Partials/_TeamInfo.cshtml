@{
    var user = ViewData["User"] as User;
    var team = (Team)ViewData["Team"]!;
    var teamNumber = ViewData["TeamNumber"] as int? ?? team.TeamNumber;
    var events = ViewData["Events"] as List<EventOption>;
    var selectedEventId = ViewData["SelectedEventID"] as int?;
}
<div id="team-info-container">
<!-- Team Header -->
<div class="card">
    <div class="card-body">
        <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
                <h2 class="text-2xl font-bold text-gray-100">Team @teamNumber</h2>
                <p class="mt-1 text-lg text-gray-400">@ViewData["TeamName"]</p>
                @if (!string.IsNullOrEmpty(team.SchoolName))
                {
                    <p class="text-sm text-gray-400 mt-2">@team.SchoolName</p>
                }
                @if (!string.IsNullOrEmpty(team.City))
                {
                    <p class="text-sm text-gray-500">@team.City@(!string.IsNullOrEmpty(team.State) ? $", {team.State}" : "")@(!string.IsNullOrEmpty(team.Country) ? $" • {team.Country}" : "")</p>
                }

                <!-- Team Details Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4">
                    @if (team.RookieYear != null)
                    {
                        <div class="rounded-lg bg-gray-800/50 px-3 py-2">
                            <div class="text-xs text-gray-500">Rookie Year</div>
                            <div class="text-sm font-semibold text-gray-100">@team.RookieYear</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(team.Nickname))
                    {
                        <div class="rounded-lg bg-gray-800/50 px-3 py-2">
                            <div class="text-xs text-gray-500">Nickname</div>
                            <div class="text-sm font-semibold text-gray-100">@team.Nickname</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(team.Website))
                    {
                        <div class="rounded-lg bg-gray-800/50 px-3 py-2">
                            <div class="text-xs text-gray-500">Website</div>
                            <a href="@team.Website" target="_blank" class="text-sm font-semibold text-teal-400 hover:text-teal-300 truncate">Visit</a>
                        </div>
                    }
                </div>

                <!-- Team Motto -->
                @if (!string.IsNullOrEmpty(team.Motto))
                {
                    <div class="mt-3 italic text-gray-400 text-sm border-l-2 border-teal-600 pl-3">
                        "@team.Motto"
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Event Selection -->
<div class="card">
    <div class="card-header accent-teal">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-100">Select Event to View</h2>
            <button
                up-href="/hx/teams/fetch-past-events"
                up-method="post"
                up-params='{"team": "@teamNumber"}'
                up-target="#team-info-container"
                class="btn btn-secondary btn-sm">
                Fetch Past Events
            </button>
        </div>
    </div>
    <div class="card-body">
        <div id="fetch-past-indicator" class="htmx-indicator flex items-center gap-2 text-xs text-gray-400 mb-3">
            <span class="loading-spinner"></span>
            Fetching past event data from FIRST API...
        </div>
        @if (user != null)
        {
            <div class="flex flex-col gap-4">
                <div class="flex-1">
                    <label for="team-event-selection" class="block text-sm font-medium text-gray-300 mb-2">Event</label>
                    <select
                        id="team-event-selection"
                        name="event_id"
                        class="w-full px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-colors"
                        tt-change="/hx/teams/data?team=@teamNumber&event_id={value}"
                        tt-target="#team-data-container"@(events is { Count: > 0 } ? " tt-load" : "")>
                        <option value="" disabled selected="@(selectedEventId == null && events is not { Count: > 0 })">Select an event to view data</option>
                        @if (events is { Count: > 0 })
                        {
                            for (var index = 0; index < events.Count; index++)
                            {
                                var evt = events[index];
                                var isSelected = selectedEventId != null ? selectedEventId == evt.Id : index == 0;
                                <option value="@evt.Id" selected="@isSelected">@evt.Name</option>
                            }
                        }
                        else
                        {
                            <option value="" disabled>No events available</option>
                        }
                    </select>
                </div>

                <div class="flex items-center gap-3 text-xs text-gray-400">
                    <div id="team-event-indicator" class="htmx-indicator flex items-center gap-2">
                        <span class="loading-spinner"></span>
                        Loading team data...
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="text-gray-400">Please sign in to view team data.</p>
        }
    </div>
</div>

<!-- Team Data Container (Unpoly target) -->
<div id="team-data-container">
    <div class="card">
        <div class="card-body text-center text-gray-400 py-12">
            <p>Select an event above to view scouting data</p>
        </div>
    </div>
</div>
</div>@* /team-info-container *@
