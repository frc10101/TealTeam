@{
    var matches = ViewData["Matches"] as List<MatchDisplay>;
    var scheduleMessage = ViewData["ScheduleMessage"] as string;
}
@if (!string.IsNullOrEmpty(scheduleMessage))
{
    <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-6 text-center text-sm text-gray-400">
        @scheduleMessage
    </div>
}
@if (matches is { Count: > 0 })
{
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-xl font-semibold text-gray-100">Current Matches</h2>
            <p class="text-sm text-gray-400 mt-1">Matches within 15 minutes</p>
        </div>
        <div class="card-body">
            <div class="space-y-3">
                @foreach (var match in matches)
                {
                    var boxClass = match.TimeStatus switch
                    {
                        "current" => "bg-yellow-900/20 border-yellow-600",
                        "past" => "bg-gray-800/50 border-gray-700",
                        _ => "bg-teal-900/20 border-teal-600",
                    };
                    <div class="border rounded-lg p-4 @boxClass transition-colors">
                        <div class="flex items-start justify-between mb-3">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-100">@match.Description</h3>
                                <p class="text-sm text-gray-400">@match.TimeDisplay</p>
                            </div>
                            <div class="flex flex-col items-end">
                                @if (match.TimeStatus == "current")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-600 text-white">
                                        Starting Soon
                                    </span>
                                }
                                else if (match.TimeStatus == "past")
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-600 text-white">
                                        Recently played
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-teal-600 text-white">
                                        In @(match.MinutesUntil)m
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- Red Alliance -->
                            <div class="bg-red-900/30 border border-red-700 rounded-lg p-3">
                                <div class="text-xs font-semibold text-red-300 mb-2">Red Alliance</div>
                                <div class="space-y-1">
                                    @foreach (var team in match.RedTeams)
                                    {
                                        <div class="text-sm font-mono text-gray-100">Team @team</div>
                                    }
                                </div>
                            </div>

                            <!-- Blue Alliance -->
                            <div class="bg-blue-900/30 border border-blue-700 rounded-lg p-3">
                                <div class="text-xs font-semibold text-blue-300 mb-2">Blue Alliance</div>
                                <div class="space-y-1">
                                    @foreach (var team in match.BlueTeams)
                                    {
                                        <div class="text-sm font-mono text-gray-100">Team @team</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (string.IsNullOrEmpty(scheduleMessage))
{
    <div class="text-sm text-gray-400 text-center py-4">
        No matches in the next 15 minutes
    </div>
}
