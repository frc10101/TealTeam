@{
    var user = ViewData["User"] as User;
    var events = ViewData["Events"] as List<EventOption>;
    var selectedEventId = ViewData["SelectedEventID"] as int?;
}
<div id="event-selection-panel" class="space-y-3 fade-swap">
    @if (user != null)
    {
        <form
            action="/api/events/select"
            method="post"
            up-submit
            up-autosubmit
            up-target="#event-selection-panel"
            up-on-inserted="up.emit('eventSelected'); up.emit('reload-matches')"
            class="flex flex-col gap-4 sm:flex-row sm:items-end">
            <div class="flex-1">
                <label for="event-selection" class="block text-sm font-medium text-gray-300 mb-2">Current Event</label>
                <select id="event-selection" name="event_id" required class="w-full px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-colors">
                    <option value="" disabled selected="@(selectedEventId == null)">Select event</option>
                    @if (events is { Count: > 0 })
                    {
                        foreach (var evt in events)
                        {
                            <option value="@evt.Id" selected="@(evt.Id == selectedEventId)">@evt.Name</option>
                        }
                    }
                    else
                    {
                        <option value="" disabled>No events available</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Set Event</button>
        </form>

        <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400">
            <div id="event-selection-indicator" class="htmx-indicator flex items-center gap-2">
                <span class="loading-spinner"></span>
                Saving selection...
            </div>
            @if (ViewData["EventUpdated"] is true)
            {
                <span class="text-teal-300">Event saved.</span>
            }
        </div>

        @if (ViewData["EventError"] is string eventError && eventError != "")
        {
            <div class="rounded-lg border border-red-600 bg-red-900/30 px-4 py-2 text-sm text-red-200">
                @eventError
            </div>
        }

        <partial name="~/Views/Partials/_EventSummary.cshtml" />
    }
    else
    {
        <div class="text-sm text-gray-400">Sign in to choose your active event.</div>
    }
</div>
