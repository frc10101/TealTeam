@{
    var stats = ViewData["TeamStats"] as TeamEventStats;
    var scoutingData = ViewData["ScoutingData"] as List<ScoutingData>;
    var scoutingCount = ViewData["ScoutingCount"] as int? ?? 0;
    var allNotes = ViewData["AllNotes"] as List<NoteEntry>;
    var autoHangStats = ViewData["AutoHangStats"] as Dictionary<string, int>;

    string Val(string key) => ViewData[key] as string ?? "";
}
<!-- Quick Summary Section -->
@if (scoutingData is { Count: > 0 } || stats != null)
{
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Event Summary</h2>
        </div>
        <div class="card-body space-y-4">
            <!-- Primary Stats: Rank, Record, Matches, Qual Average, Avg Match Points, DQ Count -->
            <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
                @if (stats?.Rank != null)
                {
                    <div class="rounded-lg border border-yellow-700/50 bg-yellow-900/20 px-4 py-3">
                        <div class="text-xs text-yellow-400 font-semibold uppercase">Rank</div>
                        <div class="text-2xl font-bold text-yellow-300">@stats.Rank</div>
                    </div>
                }

                @if (stats != null)
                {
                    <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                        <div class="text-xs text-gray-400 uppercase">Record</div>
                        <div class="text-lg font-semibold text-gray-100">
                            <span class="text-green-400">@(stats.Wins)W</span>
                            <span class="text-red-400">@(stats.Losses)L</span>
                            @if (stats.Ties > 0)
                            {
                                <span class="text-gray-400">@(stats.Ties)T</span>
                            }
                        </div>
                    </div>

                    @if (stats.MatchesPlayed > 0)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400 uppercase">Matches</div>
                            <div class="text-lg font-semibold text-gray-100">@stats.MatchesPlayed</div>
                        </div>
                    }

                    @if (stats.QualAverage != null)
                    {
                        <div class="rounded-lg border border-blue-700/50 bg-blue-900/20 px-4 py-3">
                            <div class="text-xs text-blue-400 uppercase flex items-center">
                                Qual Avg
                                <span class="stat-info border-blue-400 text-blue-400" title="Average ranking points earned per qualification match. Higher values indicate more consistent performance." aria-label="Qual Avg info">i</span>
                            </div>
                            <div class="text-lg font-semibold text-blue-300">@ViewHelpers.Float1(stats.QualAverage)</div>
                        </div>
                    }

                    @if (stats.AvgMatchPoints != null)
                    {
                        <div class="rounded-lg border border-cyan-700/50 bg-cyan-900/20 px-4 py-3">
                            <div class="text-xs text-cyan-400 uppercase flex items-center">
                                Avg Match
                                <span class="stat-info border-cyan-400 text-cyan-400" title="Average match score across all qualification matches (total alliance points, not individual team contribution)." aria-label="Avg Match info">i</span>
                            </div>
                            <div class="text-lg font-semibold text-cyan-300">@ViewHelpers.Float2(stats.AvgMatchPoints)</div>
                        </div>
                    }

                    @if (stats.DqCount > 0)
                    {
                        <div class="rounded-lg border border-red-700/50 bg-red-900/20 px-4 py-3">
                            <div class="text-xs text-red-400 uppercase">DQs</div>
                            <div class="text-lg font-semibold text-red-300">@stats.DqCount</div>
                        </div>
                    }
                }
            </div>

            <!-- OPR Stats: OPR, DPR, CCWM -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                @if (stats?.Opr != null)
                {
                    <div class="rounded-lg border border-teal-700/50 bg-teal-900/20 px-4 py-3">
                        <div class="text-xs text-teal-400 uppercase flex items-center">
                            OPR
                            <span class="stat-info border-teal-400 text-teal-400" title="Offensive Power Rating: estimated average points this team contributes to their alliance." aria-label="OPR info">i</span>
                        </div>
                        <div class="text-lg font-semibold text-teal-300">@ViewHelpers.Float1(stats.Opr)</div>
                    </div>
                }

                @if (stats?.Dpr != null)
                {
                    <div class="rounded-lg border border-orange-700/50 bg-orange-900/20 px-4 py-3">
                        <div class="text-xs text-orange-400 uppercase flex items-center">
                            DPR
                            <span class="stat-info border-orange-400 text-orange-400" title="Defensive Power Rating: estimated points prevented from opponents. Lower is better." aria-label="DPR info">i</span>
                        </div>
                        <div class="text-lg font-semibold text-orange-300">@ViewHelpers.Float1(stats.Dpr)</div>
                    </div>
                }

                @if (stats?.Ccwm != null)
                {
                    <div class="rounded-lg border border-purple-700/50 bg-purple-900/20 px-4 py-3">
                        <div class="text-xs text-purple-400 uppercase flex items-center">
                            CCWM
                            <span class="stat-info border-purple-400 text-purple-400" title="Calculated Contribution to Winning Margin (CCWM): overall impact on winning margin, approximately OPR minus DPR." aria-label="CCWM info">i</span>
                        </div>
                        <div class="text-lg font-semibold text-purple-300">@ViewHelpers.Float1(stats.Ccwm)</div>
                    </div>
                }
            </div>

            <!-- Component OPRs: Auto OPR, Teleop OPR, Endgame OPR -->
            @if (stats != null && (stats.AutoOpr != null || stats.TeleopOpr != null || stats.EndgameOpr != null))
            {
                <div class="grid grid-cols-3 gap-3">
                    @if (stats.AutoOpr != null)
                    {
                        <div class="rounded-lg border border-green-700/50 bg-green-900/20 px-4 py-3">
                            <div class="text-xs text-green-400 uppercase flex items-center">
                                Auto OPR
                                <span class="stat-info border-green-400 text-green-400" title="Autonomous OPR: estimated points contributed during the autonomous period." aria-label="Auto OPR info">i</span>
                            </div>
                            <div class="text-lg font-semibold text-green-300">@ViewHelpers.Float1(stats.AutoOpr)</div>
                        </div>
                    }
                    @if (stats.TeleopOpr != null)
                    {
                        <div class="rounded-lg border border-blue-700/50 bg-blue-900/20 px-4 py-3">
                            <div class="text-xs text-blue-400 uppercase flex items-center">
                                Teleop OPR
                                <span class="stat-info border-blue-400 text-blue-400" title="Teleop OPR: estimated points contributed during driver-controlled play." aria-label="Teleop OPR info">i</span>
                            </div>
                            <div class="text-lg font-semibold text-blue-300">@ViewHelpers.Float1(stats.TeleopOpr)</div>
                        </div>
                    }
                    @if (stats.EndgameOpr != null)
                    {
                        <div class="rounded-lg border border-purple-700/50 bg-purple-900/20 px-4 py-3">
                            <div class="text-xs text-purple-400 uppercase flex items-center">
                                Endgame OPR
                                <span class="stat-info border-purple-400 text-purple-400" title="Endgame OPR: estimated points from endgame tasks like climbing or parking." aria-label="Endgame OPR info">i</span>
                            </div>
                            <div class="text-lg font-semibold text-purple-300">@ViewHelpers.Float1(stats.EndgameOpr)</div>
                        </div>
                    }
                </div>
            }

            <!-- District Points: Qual Points, Elim Points, Award Points, Alliance Points -->
            @if (stats != null && (stats.QualPoints != null || stats.ElimPoints != null || stats.AwardPoints != null || stats.AlliancePoints != null))
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    @if (stats.QualPoints != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                            <div class="text-xs text-gray-400 uppercase">Qual Points</div>
                            <div class="font-semibold text-gray-100">@stats.QualPoints</div>
                        </div>
                    }
                    @if (stats.ElimPoints != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                            <div class="text-xs text-gray-400 uppercase">Elim Points</div>
                            <div class="font-semibold text-gray-100">@stats.ElimPoints</div>
                        </div>
                    }
                    @if (stats.AwardPoints != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                            <div class="text-xs text-gray-400 uppercase">Award Points</div>
                            <div class="font-semibold text-gray-100">@stats.AwardPoints</div>
                        </div>
                    }
                    @if (stats.AlliancePoints != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                            <div class="text-xs text-gray-400 uppercase">Alliance Points</div>
                            <div class="font-semibold text-gray-100">@stats.AlliancePoints</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}


<!-- Performance Section -->
<div class="card">
    <div class="card-header accent-teal">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-100">Performance</h2>
            @if (ViewData["EventName"] is string eventName && eventName != "")
            {
                <span class="text-xs text-gray-400">@eventName</span>
            }
        </div>
    </div>
    <div class="card-body">
        <!-- TBA Stats (if available) -->
        @if (stats != null)
        {
            <div>
                <h3 class="text-sm font-semibold text-gray-300 mb-4">TBA Event Statistics</h3>

                <!-- Primary Stats -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                    @if (stats.Rank != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400">Rank</div>
                            <div class="text-lg font-semibold text-yellow-300">@stats.Rank</div>
                        </div>
                    }
                    @if (stats.Opr != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400">OPR</div>
                            <div class="text-lg font-semibold text-teal-300">@ViewHelpers.Float2(stats.Opr)</div>
                        </div>
                    }
                    @if (stats.Dpr != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400">DPR</div>
                            <div class="text-lg font-semibold text-orange-300">@ViewHelpers.Float2(stats.Dpr)</div>
                        </div>
                    }
                    @if (stats.Ccwm != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400">CCWM</div>
                            <div class="text-lg font-semibold text-green-300">@ViewHelpers.Float2(stats.Ccwm)</div>
                        </div>
                    }
                </div>

                <!-- Record & Matches -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                    <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                        <div class="text-xs text-gray-400">Record</div>
                        <div class="text-sm font-semibold text-gray-100">
                            <span class="text-green-300">@(stats.Wins)W</span><span class="text-red-300"> @(stats.Losses)L</span>@if (stats.Ties > 0)
                            {<span class="text-gray-400"> @(stats.Ties)T</span>}
                        </div>
                    </div>
                    <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                        <div class="text-xs text-gray-400">Matches Played</div>
                        <div class="text-lg font-semibold text-gray-100">@stats.MatchesPlayed</div>
                    </div>
                    @if (stats.QualAverage != null)
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                            <div class="text-xs text-gray-400">Qual Average</div>
                            <div class="text-lg font-semibold text-blue-300">@ViewHelpers.Float1(stats.QualAverage)</div>
                        </div>
                    }
                    @if (stats.DqCount > 0)
                    {
                        <div class="rounded-lg border border-gray-700 bg-red-900/30 px-4 py-3">
                            <div class="text-xs text-red-400">Disqualifications</div>
                            <div class="text-lg font-semibold text-red-300">@stats.DqCount</div>
                        </div>
                    }
                </div>

                <!-- Component OPRs -->
                @if (stats.TeleopOpr != null || stats.EndgameOpr != null)
                {
                    <div class="mt-4 pt-4 border-t border-gray-700">
                        <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Component OPRs</h4>
                        <div class="grid grid-cols-3 gap-3">
                            @if (stats.TeleopOpr != null)
                            {
                                <div class="rounded-lg border border-blue-700/50 bg-blue-900/20 px-4 py-3">
                                    <div class="text-xs text-blue-400">Teleop OPR</div>
                                    <div class="text-lg font-semibold text-blue-300">@ViewHelpers.Float2(stats.TeleopOpr)</div>
                                </div>
                            }
                            @if (stats.EndgameOpr != null)
                            {
                                <div class="rounded-lg border border-purple-700/50 bg-purple-900/20 px-4 py-3">
                                    <div class="text-xs text-purple-400">Endgame OPR</div>
                                    <div class="text-lg font-semibold text-purple-300">@ViewHelpers.Float2(stats.EndgameOpr)</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- District Points -->
                @if (stats.QualPoints != null || stats.ElimPoints != null || stats.AwardPoints != null || stats.AlliancePoints != null || stats.TotalPoints != null)
                {
                    <div class="mt-4 pt-4 border-t border-gray-700">
                        <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">District Points</h4>
                        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                            @if (stats.QualPoints != null)
                            {
                                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                                    <div class="text-xs text-gray-400">Qual Points</div>
                                    <div class="font-semibold text-gray-100">@stats.QualPoints</div>
                                </div>
                            }
                            @if (stats.ElimPoints != null)
                            {
                                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                                    <div class="text-xs text-gray-400">Elim Points</div>
                                    <div class="font-semibold text-gray-100">@stats.ElimPoints</div>
                                </div>
                            }
                            @if (stats.AwardPoints != null)
                            {
                                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                                    <div class="text-xs text-gray-400">Award Points</div>
                                    <div class="font-semibold text-gray-100">@stats.AwardPoints</div>
                                </div>
                            }
                            @if (stats.AlliancePoints != null)
                            {
                                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                                    <div class="text-xs text-gray-400">Alliance Points</div>
                                    <div class="font-semibold text-gray-100">@stats.AlliancePoints</div>
                                </div>
                            }
                            @if (stats.TotalPoints != null)
                            {
                                <div class="rounded-lg border border-teal-700 bg-teal-900/30 px-3 py-2">
                                    <div class="text-xs text-teal-400">Total Points</div>
                                    <div class="font-semibold text-teal-300">@stats.TotalPoints</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mt-3 text-xs text-gray-500">
                    Last updated: @stats.UpdatedAt.ToLocalTime().ToString("MMM d, HH:mm")
                </div>
            </div>
        }

        <!-- Scouting Data Performance Table - Always show, fill N/A for missing -->
        <div class="@(stats != null ? "mt-6 pt-6 border-t border-gray-700" : "")">
            <h3 class="text-sm font-semibold text-gray-300 mb-4">Scouting Statistics @(scoutingCount > 0 ? $"({scoutingCount} matches)" : "")</h3>
            <div class="overflow-x-auto">
                <table class="w-full border border-gray-700 rounded-lg">
                    <thead class="bg-gray-800/50">
                        <tr class="border-b border-gray-700">
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-300 w-1/4">Metric</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-300">Value</th>
                            <th class="text-right py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Type</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm divide-y divide-gray-800">
                        <!-- ROBOT CHARACTERISTICS -->
                        <tr class="bg-gray-900/30">
                            <td colspan="3" class="py-2 px-4 text-xs font-semibold text-blue-400 uppercase tracking-wide">Robot Characteristics</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Starting Position</td>
                            <td class="py-3 px-4 @(Val("MostCommonStartPos") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("MostCommonStartPos") != "" ? Val("MostCommonStartPos") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Shooting Speed</td>
                            <td class="py-3 px-4 @(Val("ShootingSpeed") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("ShootingSpeed") != "" ? Val("ShootingSpeed") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">recent</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Capacity</td>
                            <td class="py-3 px-4 @(Val("Capacity") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("Capacity") != "" ? Val("Capacity") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">recent</td>
                        </tr>

                        <!-- STRATEGY & DEFENSE -->
                        <tr class="bg-gray-900/30">
                            <td colspan="3" class="py-2 px-4 text-xs font-semibold text-orange-400 uppercase tracking-wide">Strategy &amp; Defense</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Scoring Strategy</td>
                            <td class="py-3 px-4 @(Val("ScoringStrategy") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("ScoringStrategy") != "" ? Val("ScoringStrategy") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">recent</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Defense Rating</td>
                            <td class="py-3 px-4 @(Val("MostCommonDefense") != "" ? "text-orange-300" : "text-gray-500")">
                                @(Val("MostCommonDefense") != "" ? Val("MostCommonDefense") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Defendability</td>
                            <td class="py-3 px-4 @(Val("Defendability") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("Defendability") != "" ? Val("Defendability") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">recent</td>
                        </tr>

                        <!-- ENDGAME & HANG -->
                        <tr class="bg-gray-900/30">
                            <td colspan="3" class="py-2 px-4 text-xs font-semibold text-purple-400 uppercase tracking-wide">Endgame &amp; Hang</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Hang Level</td>
                            <td class="py-3 px-4 @(Val("MostCommonHangLevel") != "" ? "text-purple-300 font-semibold" : "text-gray-500")">
                                @(Val("MostCommonHangLevel") != "" ? Val("MostCommonHangLevel") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Auto Hang</td>
                            <td class="py-3 px-4 text-gray-100">
                                @if (autoHangStats != null &&
                                     (autoHangStats.GetValueOrDefault("yes") > 0 || autoHangStats.GetValueOrDefault("no") > 0))
                                {
                                    @:Yes: @autoHangStats.GetValueOrDefault("yes") / No: @autoHangStats.GetValueOrDefault("no")
                                }
                                else
                                {
                                    @:N/A
                                }
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">count</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Hang Position</td>
                            <td class="py-3 px-4 @(Val("MostCommonHangPosition") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("MostCommonHangPosition") != "" ? Val("MostCommonHangPosition") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>

                        <!-- TRAVERSAL & STRATEGY -->
                        <tr class="bg-gray-900/30">
                            <td colspan="3" class="py-2 px-4 text-xs font-semibold text-green-400 uppercase tracking-wide">Mobility &amp; Strategy</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Traversal</td>
                            <td class="py-3 px-4 @(Val("MostCommonTraversal") != "" ? "text-green-300 font-semibold" : "text-gray-500")">
                                @(Val("MostCommonTraversal") != "" ? Val("MostCommonTraversal") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Teleop Strategy</td>
                            <td class="py-3 px-4 @(Val("MostCommonScoringStrategy") != "" ? "text-gray-100" : "text-gray-500")">
                                @(Val("MostCommonScoringStrategy") != "" ? Val("MostCommonScoringStrategy") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>

                        <!-- ACCURACY -->
                        <tr class="bg-gray-900/30">
                            <td colspan="3" class="py-2 px-4 text-xs font-semibold text-cyan-400 uppercase tracking-wide">Data Quality</td>
                        </tr>
                        <tr class="hover:bg-gray-800/30">
                            <td class="py-3 px-4 text-gray-300">Accuracy Rating</td>
                            <td class="py-3 px-4 @(Val("MostCommonAccuracy") != "" ? "text-cyan-300 font-semibold" : "text-gray-500")">
                                @(Val("MostCommonAccuracy") != "" ? Val("MostCommonAccuracy") : "N/A")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-gray-500">mode</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Qualitative Notes Section -->
        @if (scoutingData is { Count: > 0 })
        {
            @if (allNotes is { Count: > 0 })
            {
                <div class="mt-6 pt-6 border-t border-gray-700">
                    <h3 class="text-sm font-semibold text-gray-300 mb-4">Notes from Competition</h3>
                    <div class="space-y-3">
                        @foreach (var note in allNotes)
                        {
                            <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                                <div class="flex items-start justify-between gap-4 mb-2">
                                    <div class="flex items-center gap-2 text-xs text-gray-400">
                                        <span class="px-2 py-0.5 rounded bg-gray-800 text-gray-300">Match @note.MatchIndex</span>
                                    </div>
                                    @if (note.ScoutedAt != null)
                                    {
                                        <div class="text-xs text-gray-500">@note.ScoutedAt.Value.ToLocalTime().ToString("MMM d h:mm tt")</div>
                                    }
                                </div>
                                <p class="text-sm text-gray-300">@note.Note</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (ViewData["LatestNotes"] is string latestNotes && latestNotes != "")
            {
                <div class="mt-6 pt-6 border-t border-gray-700">
                    <h3 class="text-sm font-semibold text-gray-300 mb-3">Latest Notes</h3>
                    <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-3">
                        <p class="text-sm text-gray-300">@latestNotes</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Recent Match History -->
@if (scoutingData is { Count: > 0 })
{
    <div class="card">
        <div class="card-header accent-yellow">
            <h2 class="text-lg font-semibold text-gray-100">Recent Matches</h2>
        </div>
        <div class="card-body">
            <div class="space-y-2">
                @for (var index = 0; index < scoutingData.Count && index < 5; index++)
                {
                    var match = scoutingData[index];
                    <div class="flex items-center justify-between rounded-lg border border-gray-700 bg-gray-900 px-4 py-3 text-sm">
                        <div class="flex items-center gap-4">
                            <span class="font-semibold text-gray-300">Match @(index + 1)</span>
                            <span class="text-xs px-2 py-1 rounded @(match.AllianceColor == "red" ? "bg-red-900/50 text-red-300" : "bg-blue-900/50 text-blue-300")">
                                @match.AllianceColor
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
