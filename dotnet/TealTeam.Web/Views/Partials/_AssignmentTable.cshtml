@using TealTeam.Web.Controllers
@{
    var matchRows = ViewData["MatchRows"] as List<AssignmentsController.MatchAssignmentRow> ?? new();
    var scouts = ViewData["ScoutOptions"] as List<AssignmentsController.ScoutOption> ?? new();
    var devices = ViewData["DeviceOptions"] as List<AssignmentsController.DeviceOption> ?? new();

    var totalSlots    = matchRows.SelectMany(m => m.Slots).Count(s => s.TeamId != null);
    var assignedSlots = matchRows.SelectMany(m => m.Slots).Count(s => s.AssignmentId != null);
}
<div id="assignment-table" class="space-y-4 fade-swap">

    {{!-- Header / global actions --}}
    <div class="card">
        <div class="card-header accent-teal">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <h2 class="text-lg font-semibold text-gray-100">Match Assignments</h2>
                    <span class="badge badge-gray text-xs">@assignedSlots / @totalSlots slots assigned</span>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm"
                            hx-post="/hx/assignments/auto"
                            hx-target="#assignment-table"
                            hx-swap="outerHTML transition:true"
                            hx-confirm="Distribute all unassigned slots across online scouts and devices?">
                        Auto-distribute
                    </button>
                    <button class="btn btn-danger btn-sm"
                            hx-post="/hx/assignments/clear-all"
                            hx-target="#assignment-table"
                            hx-swap="outerHTML transition:true"
                            hx-confirm="Remove ALL assignments for this event?">
                        Clear all
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (ViewData["AssignmentsInfo"] is string info && info != "")
    {
        <div class="rounded-lg border border-amber-600 bg-amber-900/20 px-4 py-3 text-sm text-amber-200">@info</div>
    }

    @if (matchRows.Count == 0)
    {
        <div class="rounded-lg border border-gray-700 bg-gray-900/40 py-10 text-center text-sm text-gray-500">
            No matches loaded for this event yet — run a TBA sync first.
        </div>
    }
    else
    {
        @foreach (var match in matchRows)
        {
            var redSlots  = match.Slots.Where(s => s.Alliance == "red").ToList();
            var blueSlots = match.Slots.Where(s => s.Alliance == "blue").ToList();
            var assignedInMatch = match.Slots.Count(s => s.AssignmentId != null);
            var totalInMatch    = match.Slots.Count(s => s.TeamId != null);

            <div class="card @(match.Played ? "opacity-50" : "")">
                <div class="card-header flex items-center justify-between py-2 @(match.Played ? "" : "border-b-accent-teal")">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="font-bold text-gray-100">@match.Label</span>
                        @if (match.ScheduledTime.HasValue)
                        {
                            <span class="text-xs text-gray-400">@match.ScheduledTime.Value.ToLocalTime().ToString("h:mm tt")</span>
                        }
                        @if (match.Played)
                        {
                            <span class="badge badge-gray">Played</span>
                        }
                        <span class="text-xs text-gray-500">@assignedInMatch/@totalInMatch assigned</span>
                    </div>
                    <button class="btn btn-secondary btn-sm"
                            hx-post="/hx/assignments/clear-match/@match.MatchId"
                            hx-target="#assignment-table"
                            hx-swap="outerHTML transition:true"
                            hx-confirm="Clear assignments for @match.Label?">
                        Clear
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-700">
                    {{!-- Red alliance --}}
                    <div>
                        <div class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-red-400 bg-red-950/40 border-b border-red-900/50">
                            Red Alliance
                        </div>
                        @foreach (var slot in redSlots)
                        {
                            var currentValue = slot.ScouterId != null ? $"u:{slot.ScouterId}"
                                             : slot.DeviceId  != null ? $"d:{slot.DeviceId}" : "";
                            <div class="flex items-center gap-3 px-4 py-2 border-b border-gray-800 last:border-0">
                                <div class="w-5 text-xs text-red-500 font-bold text-center">@slot.Position</div>
                                <div class="flex-1 min-w-0">
                                    @if (slot.TeamId != null)
                                    {
                                        <a href="/teams?team=@slot.TeamNumber"
                                           class="font-semibold text-teal-300 hover:text-teal-200 text-sm">@slot.TeamNumber</a>
                                        <span class="text-gray-400 text-xs ml-1 truncate">@slot.TeamName</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-600 text-sm italic">TBD</span>
                                    }
                                </div>
                                @if (slot.TeamId != null)
                                {
                                    <form class="shrink-0"
                                          hx-post="/hx/assignments/set"
                                          hx-target="#assignment-table"
                                          hx-swap="outerHTML transition:true"
                                          hx-trigger="change from:find select">
                                        <input type="hidden" name="match_id" value="@match.MatchId" />
                                        <input type="hidden" name="team_id" value="@slot.TeamId" />
                                        <select name="assignee"
                                                class="rounded border border-gray-700 bg-gray-900 px-2 py-1 text-xs text-gray-200 max-w-[10rem] sm:max-w-[14rem]">
                                            <option value="" selected="@(currentValue == "")">— Unassigned —</option>
                                            @if (scouts.Count > 0)
                                            {
                                                <optgroup label="Scouts">
                                                    @foreach (var scout in scouts)
                                                    {
                                                        <option value="u:@scout.Id" selected="@(currentValue == $"u:{scout.Id}")">
                                                            @scout.Name @(scout.Online ? "●" : "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                            @if (devices.Count > 0)
                                            {
                                                <optgroup label="Devices">
                                                    @foreach (var device in devices)
                                                    {
                                                        <option value="d:@device.Id" selected="@(currentValue == $"d:{device.Id}")">
                                                            @device.Name @(device.Online ? "●" : "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    {{!-- Blue alliance --}}
                    <div>
                        <div class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-950/40 border-b border-blue-900/50">
                            Blue Alliance
                        </div>
                        @foreach (var slot in blueSlots)
                        {
                            var currentValue = slot.ScouterId != null ? $"u:{slot.ScouterId}"
                                             : slot.DeviceId  != null ? $"d:{slot.DeviceId}" : "";
                            <div class="flex items-center gap-3 px-4 py-2 border-b border-gray-800 last:border-0">
                                <div class="w-5 text-xs text-blue-500 font-bold text-center">@slot.Position</div>
                                <div class="flex-1 min-w-0">
                                    @if (slot.TeamId != null)
                                    {
                                        <a href="/teams?team=@slot.TeamNumber"
                                           class="font-semibold text-teal-300 hover:text-teal-200 text-sm">@slot.TeamNumber</a>
                                        <span class="text-gray-400 text-xs ml-1 truncate">@slot.TeamName</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-600 text-sm italic">TBD</span>
                                    }
                                </div>
                                @if (slot.TeamId != null)
                                {
                                    <form class="shrink-0"
                                          hx-post="/hx/assignments/set"
                                          hx-target="#assignment-table"
                                          hx-swap="outerHTML transition:true"
                                          hx-trigger="change from:find select">
                                        <input type="hidden" name="match_id" value="@match.MatchId" />
                                        <input type="hidden" name="team_id" value="@slot.TeamId" />
                                        <select name="assignee"
                                                class="rounded border border-gray-700 bg-gray-900 px-2 py-1 text-xs text-gray-200 max-w-[10rem] sm:max-w-[14rem]">
                                            <option value="" selected="@(currentValue == "")">— Unassigned —</option>
                                            @if (scouts.Count > 0)
                                            {
                                                <optgroup label="Scouts">
                                                    @foreach (var scout in scouts)
                                                    {
                                                        <option value="u:@scout.Id" selected="@(currentValue == $"u:{scout.Id}")">
                                                            @scout.Name @(scout.Online ? "●" : "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                            @if (devices.Count > 0)
                                            {
                                                <optgroup label="Devices">
                                                    @foreach (var device in devices)
                                                    {
                                                        <option value="d:@device.Id" selected="@(currentValue == $"d:{device.Id}")">
                                                            @device.Name @(device.Online ? "●" : "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
