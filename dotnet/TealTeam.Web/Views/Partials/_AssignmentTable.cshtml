@using TealTeam.Web.Controllers
@{
    var rows = ViewData["AssignmentRows"] as List<AssignmentsController.AssignmentRow> ?? new();
    var scouts = ViewData["ScoutOptions"] as List<AssignmentsController.ScoutOption> ?? new();
    var devices = ViewData["DeviceOptions"] as List<AssignmentsController.DeviceOption> ?? new();
    var assignedCount = rows.Count(r => r.AssignmentId != null);
}
<div id="assignment-table" class="card fade-swap">
    <div class="card-header accent-teal">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-gray-100">Robot Assignments</h2>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs text-gray-400">@assignedCount / @rows.Count assigned</span>
                <button class="btn btn-primary btn-sm"
                        hx-post="/hx/assignments/auto"
                        hx-target="#assignment-table"
                        hx-swap="outerHTML transition:true"
                        hx-confirm="Distribute all unassigned robots across online scouts and devices?">
                    Auto-distribute
                </button>
                <button class="btn btn-danger btn-sm"
                        hx-post="/hx/assignments/clear-all"
                        hx-target="#assignment-table"
                        hx-swap="outerHTML transition:true"
                        hx-confirm="Remove ALL assignments for this event?">
                    Clear all
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (ViewData["AssignmentsInfo"] is string info && info != "")
        {
            <div class="mb-3 rounded-lg border border-amber-600 bg-amber-900/20 px-4 py-2 text-sm text-amber-200">@info</div>
        }
        @if (rows.Count == 0)
        {
            <div class="text-center text-sm text-gray-500 py-6">No teams loaded for this event yet. Run a sync first.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs uppercase text-gray-400 border-b border-gray-700">
                        <tr>
                            <th class="py-2 pr-4">Robot</th>
                            <th class="py-2 pr-4">Assigned To</th>
                            <th class="py-2 pr-4">Change</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var row in rows)
                        {
                            var currentValue = row.ScouterId != null ? $"u:{row.ScouterId}"
                                : row.DeviceId != null ? $"d:{row.DeviceId}" : "";
                            <tr>
                                <td class="py-3 pr-4">
                                    <a href="/teams?team=@row.TeamNumber" class="text-teal-300 hover:text-teal-200 font-semibold">@row.TeamNumber</a>
                                    <span class="text-gray-400 ml-2">@row.TeamName</span>
                                </td>
                                <td class="py-3 pr-4">
                                    @if (row.ScouterName != null)
                                    {
                                        <span class="badge badge-teal">@row.ScouterName</span>
                                    }
                                    else if (row.DeviceName != null)
                                    {
                                        <span class="badge badge-yellow">
                                            @row.DeviceName
                                            @if (row.AssigneeOnline)
                                            {
                                                <span class="ml-1 text-teal-300">●</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Unassigned</span>
                                    }
                                </td>
                                <td class="py-3 pr-4">
                                    <form hx-post="/hx/assignments/set"
                                          hx-target="#assignment-table"
                                          hx-swap="outerHTML transition:true"
                                          hx-trigger="change from:find select">
                                        <input type="hidden" name="team_id" value="@row.TeamId" />
                                        <select name="assignee" class="w-full max-w-xs rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm text-gray-200">
                                            <option value="" selected="@(currentValue == "")">— Unassigned —</option>
                                            @if (scouts.Count > 0)
                                            {
                                                <optgroup label="Scouts">
                                                    @foreach (var scout in scouts)
                                                    {
                                                        <option value="u:@scout.Id" selected="@(currentValue == $"u:{scout.Id}")">@scout.Name @(scout.Online ? "●" : "")</option>
                                                    }
                                                </optgroup>
                                            }
                                            @if (devices.Count > 0)
                                            {
                                                <optgroup label="Devices">
                                                    @foreach (var device in devices)
                                                    {
                                                        <option value="d:@device.Id" selected="@(currentValue == $"d:{device.Id}")">@device.Name @(device.Online ? "●" : "")</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
