@{
    var user = ViewData["User"] as User;
    var isLead = user != null && (user.IsAdmin || user.IsLeadScout);
    var isCoach = user != null && (user.IsAdmin || user.IsCoach);
}
<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-3xl font-bold text-gray-100">How to Use TealTeam</h1>
        <p class="mt-2 text-gray-400">Quick guides for scouts, lead scouts, and drive coaches.</p>
    </div>

    <!-- Getting started -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Getting Started</h2>
        </div>
        <div class="card-body space-y-3 text-sm text-gray-300">
            <ol class="list-decimal list-inside space-y-2">
                <li><a href="/sign-up" class="text-teal-300 hover:text-teal-200">Create an account</a> with your team number. Check "Lead scout" or "Drive coach" only if that's your role.</li>
                <li>On the <a href="/" class="text-teal-300 hover:text-teal-200">home page</a>, select the event you're attending under <span class="text-gray-100 font-medium">Event Selection</span>. Everything else (schedules, assignments, submissions) follows from this choice.</li>
                <li>This device registers itself automatically the first time it opens the site. Your lead scout can assign a robot to <em>you</em> or to <em>this device</em> — either way the scouting form pre-fills for you.</li>
            </ol>
            <p class="text-xs text-gray-500">Sessions last 24 hours — sign in once at the start of each competition day.</p>
        </div>
    </div>

    <!-- Scouts -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Scouts: Entering Match Data</h2>
        </div>
        <div class="card-body space-y-3 text-sm text-gray-300">
            <ol class="list-decimal list-inside space-y-2">
                <li>Open <a href="/submission" class="text-teal-300 hover:text-teal-200">Scouting Submission</a>. If you've been assigned a robot, a green banner shows it and the Event/Team fields are already filled in — don't change them unless your lead tells you to.</li>
                <li>Watch <span class="text-gray-100 font-medium">only your assigned robot</span> for the whole match.</li>
                <li>Set <span class="text-gray-100 font-medium">Alliance Color</span> to the bumper color your robot has <em>this match</em> — it changes between matches.</li>
                <li>Fill in what you observed. A best guess is better than leaving a field blank; required fields are marked and the form will tell you if one is missing.</li>
                <li>Write one or two specific <span class="text-gray-100 font-medium">Notes</span> ("slow feeder pickup", "great defense on 254"). Notes are private to your team.</li>
                <li>Press <span class="text-gray-100 font-medium">Submit Scouting Data</span> once per robot per match. Your submission goes to the lead scout for review — if you made a mistake, tell your lead rather than resubmitting.</li>
            </ol>
        </div>
    </div>

    @if (isLead)
    {
        <!-- Lead scouts -->
        <div class="card">
            <div class="card-header accent-red">
                <h2 class="text-lg font-semibold text-gray-100">Lead Scouts</h2>
            </div>
            <div class="card-body space-y-3 text-sm text-gray-300">
                <ul class="list-disc list-inside space-y-2">
                    <li><span class="text-gray-100 font-medium"><a href="/lead-scout/assignments" class="text-teal-300 hover:text-teal-200">Scout Assignments</a></span> — assign each robot at the event to a scout (by name) or a device (e.g. "Stands Tablet 1"). A <span class="text-teal-300">●</span> means they're connected right now. "Auto-distribute" spreads unassigned robots across everyone online. Assignees get pre-filled forms automatically.</li>
                    <li><span class="text-gray-100 font-medium"><a href="/lead-scout" class="text-teal-300 hover:text-teal-200">Submission Approvals</a></span> — review each pending submission ("Missing notes" flags entries without notes). Approving moves it into the team dataset; declining deletes it.</li>
                    <li><span class="text-gray-100 font-medium"><a href="/lead-scout/weights" class="text-teal-300 hover:text-teal-200">Point Weights</a></span> — tune how much each scouting category contributes to the Team Rankings score.</li>
                    <li><span class="text-gray-100 font-medium">Pick List</span> — build and reorder your alliance-selection list on the lead scout panel; it syncs for your whole team.</li>
                </ul>
            </div>
        </div>
    }

    @if (isCoach)
    {
        <!-- Drive coaches -->
        <div class="card">
            <div class="card-header accent-yellow">
                <h2 class="text-lg font-semibold text-gray-100">Drive Coaches</h2>
            </div>
            <div class="card-body space-y-3 text-sm text-gray-300">
                <ul class="list-disc list-inside space-y-2">
                    <li>The <a href="/drive-coach" class="text-teal-300 hover:text-teal-200">Drive Coach Panel</a> shows your team's match schedule with alliance partners and their OPR/DPR.</li>
                    <li>The highlighted <span class="text-yellow-300">Current Match</span> card is the one inside a ±15 minute window from its scheduled start.</li>
                    <li>Tap any team number anywhere in the app to open its full scouting and stats page.</li>
                </ul>
            </div>
        </div>
    }

    <!-- Reading team data -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Looking Up Team Data</h2>
        </div>
        <div class="card-body space-y-3 text-sm text-gray-300">
            <ul class="list-disc list-inside space-y-2">
                <li>Use the <span class="text-gray-100 font-medium">Team #</span> search in the top bar (or the <a href="/teams" class="text-teal-300 hover:text-teal-200">Teams page</a>), then pick an event to see stats.</li>
                <li><span class="text-gray-100 font-medium">OPR</span> ≈ points a robot contributes per match; <span class="text-gray-100 font-medium">DPR</span> ≈ points allowed (lower is better); <span class="text-gray-100 font-medium">CCWM</span> ≈ overall winning-margin impact. Hover the <span class="stat-info border-teal-400 text-teal-400" title="Like this!">i</span> icons for definitions.</li>
                <li>Scouting statistics marked <span class="text-gray-100 font-medium">mode</span> show the most common observation across matches; <span class="text-gray-100 font-medium">recent</span> shows the latest one.</li>
                <li>Notes are only visible to members of the team that wrote them.</li>
            </ul>
        </div>
    </div>
</div>
