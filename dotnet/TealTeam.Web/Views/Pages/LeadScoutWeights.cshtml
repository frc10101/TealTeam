@{
    var sections = ViewData["Sections"] as List<ScoutingPointSection> ?? new List<ScoutingPointSection>();
}
<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-100">@ViewData["Title"]</h1>
            <p class="mt-2 text-gray-400">@ViewData["Description"]</p>
        </div>
        <a href="/lead-scout?team_sort=points" class="btn btn-secondary">Back to Lead Scout Panel</a>
    </div>

    @if (ViewData["Updated"] is true)
    {
        <div class="rounded-lg border border-teal-700 bg-teal-900/30 px-4 py-3 text-sm text-teal-200">
            Point weights were updated. Team rankings now use the latest values.
        </div>
    }
    @if (ViewData["Error"] is string error && error != "")
    {
        <div class="rounded-lg border border-red-700 bg-red-900/30 px-4 py-3 text-sm text-red-200">
            @error
        </div>
    }

    <form method="post" action="/lead-scout/weights" class="space-y-6">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var weightSection in sections)
            {
                <div class="card">
                    <div class="card-header accent-teal">
                        <h2 class="text-lg font-semibold text-gray-100">@weightSection.Label</h2>
                    </div>
                    <div class="card-body space-y-3">
                        @foreach (var option in weightSection.Options)
                        {
                            var fieldName = $"weight_{weightSection.Key}__{option.Key}";
                            <div class="flex items-center justify-between gap-3">
                                <label for="@fieldName" class="text-sm text-gray-300">@ViewHelpers.OptionLabel(option.Key)</label>
                                <input
                                    id="@fieldName"
                                    name="@fieldName"
                                    type="number"
                                    min="-100"
                                    max="100"
                                    value="@option.Points"
                                    class="w-20 rounded-lg border border-gray-700 bg-gray-900 px-3 py-1.5 text-right text-sm text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500"
                                />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary">Save and Update Rankings</button>
            <a href="/lead-scout" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
