@{
    var teamNumber = ViewData["TeamNumber"] as int?;
}
<div class="space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-100">Team Lookup</h1>
            <p class="mt-2 text-gray-400">Search for a team to view scouting data</p>
        </div>
    </div>

    <!-- Team Search -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Team Search</h2>
        </div>
        <div class="card-body space-y-4">
            <form
                action="/hx/teams/search"
                method="get"
                up-submit
                up-target="#team-info-container"
                class="flex flex-col gap-3 sm:flex-row sm:items-end">
                <div class="flex-1">
                    <label for="team-search" class="block text-sm font-medium text-gray-300 mb-2">Team Number</label>
                    <input
                        id="team-search"
                        name="team"
                        type="number"
                        min="1"
                        inputmode="numeric"
                        placeholder="e.g. 10101"
                        value="@ViewData["TeamSearchValue"]"
                        required
                        class="w-full px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-colors"
                    />
                </div>
                <button type="submit" class="btn btn-primary">Search Team</button>
            </form>
            @if (ViewData["TeamError"] is string teamError && teamError != "")
            {
                <div class="rounded-lg border border-red-600 bg-red-900/30 px-4 py-2 text-sm text-red-200">
                    @teamError
                </div>
            }
        </div>
    </div>

    <!-- Team Info Container (Unpoly target) -->
    @* _TeamInfo self-wraps with id="team-info-container" *@
    @if (teamNumber != null)
    {
        <partial name="~/Views/Partials/_TeamInfo.cshtml" />
    }
    else
    {
        <div id="team-info-container">
            <div class="card">
                <div class="card-body text-center text-gray-400 py-12">
                    <p>Enter a team number above to get started</p>
                </div>
            </div>
        </div>
    }
</div>
