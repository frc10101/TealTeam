<div class="space-y-8">
    <!-- Hero Section -->
    <div class="text-center py-12">
        <h1 class="text-4xl font-bold text-gray-100 mb-4">
            @ViewData["Message"]
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            FRC Scouting Application - Track team performance, collect match data, and make informed strategic decisions.
        </p>
    </div>

    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-xl font-semibold text-gray-100">Event Selection</h2>
        </div>
        <div class="card-body">
            <partial name="~/Views/Partials/_EventSelection.cshtml" />
        </div>
    </div>

    <!-- Match Schedule (auto-refreshes every 30 seconds) -->
    <div
        id="match-schedule-container"
        tt-src="/hx/matches/schedule" tt-load tt-poll="30000" tt-on="eventSelected"
        class="fade-swap">
        <div class="flex justify-center py-8">
            <span class="loading-spinner"></span>
        </div>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
            <div class="card-header accent-teal"></div>
            <div class="card-body">
                <h3 class="text-lg font-semibold text-gray-100 mb-2">📋 Match Scouting</h3>
                <p class="text-gray-400">
                    Collect detailed match data for teams during competitions. Track performance metrics, strategic capabilities, and game-specific actions.
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-header accent-red"></div>
            <div class="card-body">
                <h3 class="text-lg font-semibold text-gray-100 mb-2">🤖 Team Analytics</h3>
                <p class="text-gray-400">
                    View comprehensive team statistics, rankings, and historical performance. Integrated with The Blue Alliance API for official data.
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-header accent-yellow"></div>
            <div class="card-body">
                <h3 class="text-lg font-semibold text-gray-100 mb-2">🎯 Strategic Planning</h3>
                <p class="text-gray-400">
                    Access drive coach and lead scout panels for match strategy, alliance selection, and real-time decision making during competitions.
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Start -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-xl font-semibold text-gray-100">Getting Started</h2>
        </div>
        <div class="card-body">
            <div class="prose max-w-none">
                <p class="mb-4 text-gray-400">Ready to start scouting? View the submission form to collect match data:</p>
                <a href="/submission" class="btn btn-primary">
                    Go to Scouting Form →
                </a>
            </div>
        </div>
    </div>
</div>
