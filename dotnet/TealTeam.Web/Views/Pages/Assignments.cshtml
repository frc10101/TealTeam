@{
    var selectedEventId = ViewData["SelectedEventID"] as int?;
}
<div class="space-y-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-100">@ViewData["Title"]</h1>
            <p class="mt-2 text-gray-400">@ViewData["Description"]</p>
        </div>
        <a href="/lead-scout" class="btn btn-secondary">Back to Lead Scout Panel</a>
    </div>

    @if (selectedEventId == null)
    {
        <div class="rounded-lg border border-amber-600 bg-amber-900/20 px-4 py-6 text-center text-sm text-amber-200">
            <div class="font-semibold">No event selected</div>
            <div class="mt-1">@ViewData["AssignmentsInfo"]</div>
            <a href="/" class="mt-3 inline-block btn btn-primary btn-sm">Go to event selection</a>
        </div>
    }
    else
    {
        <div class="rounded-lg border border-gray-700 bg-gray-900/60 px-4 py-3 text-sm text-gray-400">
            Assigning for <span class="font-semibold text-gray-200">@ViewData["SelectedEventName"]</span>.
            Assignees see their robot pre-filled on the scouting form.
            <span class="text-teal-300">●</span> means connected right now.
        </div>

        <!-- Devices -->
        <div class="card">
            <div class="card-header accent-yellow">
                <h2 class="text-lg font-semibold text-gray-100">Registered Devices</h2>
            </div>
            <div class="card-body" id="device-list-container">
                <partial name="~/Views/Partials/_DeviceList.cshtml" />
            </div>
        </div>

        <!-- Match assignment table (auto-refreshes online indicators) -->
        <div hx-get="/lead-scout/assignments"
             hx-select="#assignment-table"
             hx-target="#assignment-table"
             hx-swap="outerHTML"
             hx-trigger="every 30s">
            <partial name="~/Views/Partials/_AssignmentTable.cshtml" />
        </div>
    }
</div>
