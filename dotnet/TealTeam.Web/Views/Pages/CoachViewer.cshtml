@{
    var summary = ViewData["DriveCoachSummary"] as Dictionary<string, object>;
}
<div class="space-y-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-100">@ViewData["Title"]</h1>
            <p class="mt-2 text-gray-400">@ViewData["Description"]</p>
        </div>
        @if (summary != null)
        {
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-5">
                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-center">
                    <div class="text-xs uppercase tracking-wider text-gray-400">Event</div>
                    <div class="text-sm font-semibold text-gray-100 truncate">@summary.GetValueOrDefault("EventName")</div>
                </div>
                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-center">
                    <div class="text-xs uppercase tracking-wider text-gray-400">Team</div>
                    <div class="text-sm font-semibold text-teal-300">@summary.GetValueOrDefault("TeamNumber")</div>
                </div>
                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-center">
                    <div class="text-xs uppercase tracking-wider text-gray-400">Current</div>
                    <div class="text-sm font-semibold text-yellow-300">@summary.GetValueOrDefault("CurrentMatches")</div>
                </div>
                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-center">
                    <div class="text-xs uppercase tracking-wider text-gray-400">Upcoming</div>
                    <div class="text-sm font-semibold text-gray-100">@summary.GetValueOrDefault("UpcomingMatches")</div>
                </div>
                <div class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-center">
                    <div class="text-xs uppercase tracking-wider text-gray-400">Completed</div>
                    <div class="text-sm font-semibold text-gray-500">@summary.GetValueOrDefault("CompletedMatches")</div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Event Selection</h2>
        </div>
        <div class="card-body">
            <partial name="~/Views/Partials/_EventSelection.cshtml" />
        </div>
    </div>

    <div id="drive-coach-matches-container"
         tt-src="/hx/drive-coach/matches" tt-on="reload-matches">
        <partial name="~/Views/Partials/_DriveCoachMatches.cshtml" />
    </div>
</div>
