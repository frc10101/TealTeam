@{
    var pendingSubmissions = ViewData["PendingSubmissions"] as List<PendingSubmissionRow>;
    var teamRankings = ViewData["TeamRankings"] as List<TeamPointSummary>;
    var pickListTeams = ViewData["PickListTeams"] as List<PickListTeam>;
    var teamRankingSort = ViewData["TeamRankingSort"] as string ?? "";
    var selectedEventId = ViewData["SelectedEventID"] as int?;

    string SortClass(params string[] keys) => keys.Contains(teamRankingSort)
        ? "text-teal-300"
        : "text-gray-400 hover:text-gray-300";
}
<div class="space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-100">@ViewData["Title"]</h1>
            <p class="mt-2 text-gray-400">@ViewData["Description"]</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/lead-scout/assignments" class="btn btn-primary">Scout Assignments</a>
            <a href="/lead-scout/weights" class="btn btn-secondary">Point Weights</a>
        </div>
    </div>

    <!-- Main Panels -->
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-6">
            <div class="card">
                <div class="card-header accent-teal">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-gray-100">Submission Approvals</h2>
                        <span class="text-xs text-gray-400">Lead scout queue</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="text-xs uppercase text-gray-400 border-b border-gray-700">
                                <tr>
                                    <th class="py-2 pr-4">Event</th>
                                    <th class="py-2 pr-4">Team</th>
                                    <th class="py-2 pr-4">Scout</th>
                                    <th class="py-2 pr-4">Flags</th>
                                    <th class="py-2 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-800">
                                @if (pendingSubmissions is { Count: > 0 })
                                {
                                    foreach (var submission in pendingSubmissions)
                                    {
                                        <tr id="submission-@submission.Id" class="fade-swap">
                                            <td class="py-3 pr-4 text-gray-200">@submission.EventName</td>
                                            <td class="py-3 pr-4 text-gray-200">
                                                <a href="/teams?team=@submission.TeamNumber" class="text-teal-300 hover:text-teal-200">Team @submission.TeamNumber</a>
                                            </td>
                                            <td class="py-3 pr-4 text-gray-400">@submission.ScoutName</td>
                                            <td class="py-3 pr-4 @submission.FlagClass">@submission.FlagLabel</td>
                                            <td class="py-3 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <a href="/lead-scout/submissions/@submission.Id" target="_blank" class="btn btn-sm btn-secondary">View</a>
                                                    <button class="btn btn-sm btn-primary" hx-post="/hx/lead-scout/submissions/@submission.Id/approve" hx-target="#submission-@submission.Id" hx-swap="outerHTML transition:true">Approve</button>
                                                    <button class="btn btn-sm btn-danger" hx-post="/hx/lead-scout/submissions/@submission.Id/decline" hx-target="#submission-@submission.Id" hx-swap="outerHTML transition:true">Decline</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td class="py-6 text-center text-sm text-gray-500" colspan="5">No pending submissions.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        <button class="btn btn-primary btn-sm">Approve all clean</button>
                        <button class="btn btn-danger btn-sm">Send back flagged</button>
                        <a href="/development/db" class="text-sm text-teal-300 hover:text-teal-200">Open database viewer</a>
                    </div>
                </div>
            </div>

        </div>

        <div class="space-y-6">
            <div class="card">
                <div class="card-header accent-red">
                    <h2 class="text-lg font-semibold text-gray-100">Match View</h2>
                </div>
                <div class="card-body space-y-3">
                    @if (selectedEventId != null)
                    {
                        <div
                            id="admin-match-schedule-container"
                            hx-get="/hx/matches/schedule"
                            hx-trigger="load, every 30s, eventSelected from:body"
                            hx-swap="innerHTML"
                            class="fade-swap">
                            <div class="flex justify-center py-6">
                                <span class="loading-spinner"></span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg border border-gray-700 bg-gray-900 px-4 py-6 text-center text-sm text-gray-500">
                            Select an event on the home page to view live matches.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Team Rankings Table - Full Width -->
    <div class="card">
        <div class="card-header accent-purple">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-100">Team Rankings</h2>
                <div class="flex gap-2 text-xs">
                    <a href="?team_sort=rank" class="@SortClass("", "rank")">Rank</a>
                    <span class="text-gray-600">|</span>
                    <a href="?team_sort=points" class="@SortClass("points")">Points</a>
                    <span class="text-gray-600">|</span>
                    <a href="?team_sort=number" class="@SortClass("number")">Number</a>
                    <span class="text-gray-600">|</span>
                    <a href="?team_sort=name" class="@SortClass("name")">Name</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (teamRankings is { Count: > 0 })
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs uppercase text-gray-400 border-b border-gray-700">
                            <tr>
                                <th class="py-2 pr-4">Rank</th>
                                <th class="py-2 pr-4">Team</th>
                                <th class="py-2 pr-4">Name</th>
                                <th class="py-2 text-right">Points</th>
                                <th class="py-2 text-right">Matches</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-800">
                            @foreach (var team in teamRankings)
                            {
                                <tr>
                                    <td class="py-3 pr-4 text-gray-400">@(team.Rank != null ? $"#{team.Rank}" : "-")</td>
                                    <td class="py-3 pr-4 font-semibold text-gray-200">
                                        <a href="/teams?team=@team.TeamNumber" class="text-teal-300 hover:text-teal-200">@team.TeamNumber</a>
                                    </td>
                                    <td class="py-3 pr-4 text-gray-400">@team.TeamName</td>
                                    <td class="py-3 text-right text-teal-300 font-semibold">@team.Points</td>
                                    <td class="py-3 text-right text-gray-400">@team.Matches</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-sm text-gray-500 py-6">
                    No team rankings available yet.
                </div>
            }
        </div>
    </div>

    <!-- Pick List - Full Width -->
    <div class="card">
        <div class="card-header accent-teal">
            <h2 class="text-lg font-semibold text-gray-100">Pick List</h2>
        </div>
        <div class="card-body">
            <div class="text-sm text-gray-400">Add teams to your pick list, then mark them by color. Colors sync on this device only. Drag to reorder.</div>
            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-400">
                <span class="rounded-full bg-red-900 px-2 py-1 text-red-200">Red</span>
                <span class="rounded-full bg-yellow-900 px-2 py-1 text-yellow-200">Yellow</span>
                <span class="rounded-full bg-teal-900 px-2 py-1 text-teal-200">Turquoise</span>
                <span class="rounded-full border border-gray-700 px-2 py-1 text-gray-400">Crossed</span>
            </div>
            @if (pickListTeams is { Count: > 0 })
            {
                <div class="mt-4 flex flex-wrap items-center gap-2">
                    <button type="button" id="pick-list-add-toggle" class="rounded-lg border border-teal-600 bg-teal-900 px-3 py-2 text-sm font-semibold text-teal-100 hover:bg-teal-800">+ Add Team</button>
                    <div id="pick-list-add-panel" class="hidden flex-wrap items-center gap-2">
                        <select id="pick-list-team-select" class="rounded-lg border border-gray-700 bg-gray-900 px-3 py-2 text-sm text-gray-200">
                            <option value="">Select a team...</option>
                            @foreach (var team in pickListTeams)
                            {
                                <option value="@team.TeamNumber" data-team-name="@team.TeamName" data-rank="@(team.Rank?.ToString() ?? "")">@(team.Rank != null ? $"#{team.Rank} - " : "")Team @team.TeamNumber @(team.TeamName != "" ? $"- {team.TeamName}" : "")</option>
                            }
                        </select>
                        <button type="button" id="pick-list-add-team" class="rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-sm text-gray-200 hover:bg-gray-700">Add</button>
                    </div>
                </div>
                <ul id="pick-list" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></ul>
            }
            else
            {
                <div class="mt-4 text-sm text-gray-500">No teams loaded.</div>
            }
        </div>
    </div>
</div>
